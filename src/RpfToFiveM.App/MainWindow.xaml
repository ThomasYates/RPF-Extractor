<Window x:Class="RpfToFiveM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RpfToFiveM.App"
        xmlns:core="clr-namespace:RpfToFiveM.Core.Extraction;assembly=RpfToFiveM.Core"
        Title="RPF Extractor" Width="1180" Height="760" MinWidth="980" MinHeight="700"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="12.5"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding ProgressValue}" ProgressState="{Binding TaskbarState}" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Unfinished job from a crash / early exit -->
        <Border Grid.Row="0" Background="#1E1A10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasPendingJob, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,0,16,0">
                <Border DockPanel.Dock="Left" Width="3" Background="{StaticResource Signal}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Discard" Width="80" Command="{Binding DiscardJobCommand}" />
                    <Button Style="{StaticResource GoButton}" Content="Resume job" Width="100" Margin="8,0,0,0" Command="{Binding ResumeJobCommand}" />
                </StackPanel>
                <TextBlock Margin="14,11,16,11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding PendingJobText}" ToolTip="{Binding PendingJobText}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: job settings -->
            <Border Background="{StaticResource PaneBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="22,20,22,22">
                    <!-- Controls pinned to the bottom -->
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GoButton}" Content="Start extraction" Height="34" Command="{Binding StartCommand}" />
                        <Button Grid.Column="1" Content="{Binding PauseButtonText}" Height="34" Margin="8,0,0,0" Command="{Binding PauseResumeCommand}" />
                        <Button Grid.Column="2" Content="Stop" Height="34" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                    </Grid>

                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Folders" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Original RPF folder" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseSourceCommand}" />
                            <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Searched recursively for .rpf files" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Export location" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseOutputCommand}" />
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="GTA V install (for encrypted game archives)" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Command="{Binding BrowseGameCommand}" />
                            <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="Leave empty for mod RPFs saved with OpenIV or CodeWalker." />

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Format" Margin="0,0,0,12" />
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" Background="{StaticResource FieldBg}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Folder dump" IsChecked="{Binding DumpMode}" />
                                <Border Width="1" Background="{StaticResource LineStrong}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="FiveM map" IsChecked="{Binding FiveMMode}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="{Binding ModeDescription}" />

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding FiveMMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Resource name" />
                            <TextBox Text="{Binding ResourceName, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                                     FontFamily="{StaticResource Mono}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,16" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Z-fight fix" Margin="0,0,0,12" />
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" Background="{StaticResource FieldBg}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="ZFight" Content="Off" MinWidth="64" IsChecked="{Binding ZFightOff}" />
                                <Border Width="1" Background="{StaticResource LineStrong}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ZFight" Content="On" MinWidth="64" IsChecked="{Binding ZFightOn}" />
                                <Border Width="1" Background="{StaticResource LineStrong}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ZFight" Content="Both" MinWidth="64" IsChecked="{Binding ZFightBoth}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="{Binding ZFightDescription}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Right: live progress + log -->
            <DockPanel Grid.Column="1" Margin="26,20,26,20">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource Mono}" FontSize="30" />
                            <TextBlock Text="%" FontFamily="{StaticResource Mono}" FontSize="16" Foreground="{StaticResource InkDim}"
                                       Margin="3,0,0,5" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </DockPanel>

                    <ProgressBar Style="{StaticResource FlatProgress}" Margin="0,10,0,0"
                                 Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Files" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding FilesText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Data" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding SizeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Rate" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding SpeedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Remaining" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding EtaText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource StatLabel}" Text="Elapsed" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,14,0,0" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource InkDim}"
                               TextTrimming="CharacterEllipsis" Text="{Binding CurrentItem}" ToolTip="{Binding CurrentItem}" />

                    <DockPanel Margin="0,20,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Open output folder" Command="{Binding OpenOutputCommand}" />
                            <Button Style="{StaticResource LinkButton}" Content="Open log" Margin="16,0,0,0" Command="{Binding OpenLogFileCommand}"
                                    ToolTip="logs.txt next to the exe. Folder paths are hidden, so it's safe to share." />
                            <Button Style="{StaticResource LinkButton}" Content="Clear" Margin="16,0,0,0" Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Log" />
                    </DockPanel>
                </StackPanel>

                <Border Background="{StaticResource ConsoleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Padding="0,6"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="10,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:LogItem}">
                                <DockPanel TextElement.FontFamily="{StaticResource Mono}" TextElement.FontSize="11.5">
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource InkFaint}" Width="64" />
                                    <TextBlock x:Name="Tag" Text="{Binding Tag}" Foreground="{StaticResource InkFaint}" Width="34" />
                                    <TextBlock x:Name="Msg" Text="{Binding Message}" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Warning}">
                                        <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Warn}" />
                                        <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Error}">
                                        <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Bad}" />
                                        <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Bad}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#111111" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,4">
                <TextBlock DockPanel.Dock="Right" Text="v1.2" Foreground="{StaticResource InkFaint}" FontSize="11" />
                <TextBlock Text="{Binding KeysText}" Foreground="{StaticResource InkFaint}" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
