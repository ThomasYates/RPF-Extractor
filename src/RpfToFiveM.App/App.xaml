<Application x:Class="RpfToFiveM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Flat, tool-style palette: neutral greys and one signal colour. -->
            <SolidColorBrush x:Key="WindowBg" Color="#161616" />
            <SolidColorBrush x:Key="PaneBg" Color="#1B1B1B" />
            <SolidColorBrush x:Key="FieldBg" Color="#111111" />
            <SolidColorBrush x:Key="ConsoleBg" Color="#0F0F0F" />
            <SolidColorBrush x:Key="Line" Color="#2B2B2B" />
            <SolidColorBrush x:Key="LineStrong" Color="#3A3A3A" />
            <SolidColorBrush x:Key="Ink" Color="#DADADA" />
            <SolidColorBrush x:Key="InkDim" Color="#8C8C8C" />
            <SolidColorBrush x:Key="InkFaint" Color="#5E5E5E" />
            <SolidColorBrush x:Key="Signal" Color="#F2A900" />
            <SolidColorBrush x:Key="SignalDim" Color="#3A2D0B" />
            <SolidColorBrush x:Key="Warn" Color="#E3B341" />
            <SolidColorBrush x:Key="Bad" Color="#F0645A" />
            <SolidColorBrush x:Key="Good" Color="#7BC96F" />

            <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkDim}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="16" />
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <!-- Path field -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="Background" Value="{StaticResource FieldBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
                <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
                <Setter Property="SelectionBrush" Value="{StaticResource Signal}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#505050" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Signal}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buttons -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="Background" Value="#242424" />
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2E2E2E" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1C1C1C" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                                    <Setter TargetName="Bd" Property="Background" Value="#1D1D1D" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="#111111" />
                <Setter Property="Background" Value="{StaticResource Signal}" />
                <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFBB22" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D69500" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6E5A26" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SignalDim}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource InkDim}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource Ink}" />
                                    <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource InkFaint}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Two-way mode switch: [ Folder dump | FiveM map ] -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource InkDim}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2C2C2C" />
                                    <Setter Property="Foreground" Value="{StaticResource Signal}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Progress: flat fill, sweeping block while scanning -->
            <Style x:Key="FlatProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="10" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="#0C0C0C" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                <Grid ClipToBounds="True" Margin="1">
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Signal}" />
                                    <Border x:Name="Sweep" Width="90" HorizontalAlignment="Left" Background="#8A6300" Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SweepShift" X="-90" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="SweepAnim">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X"
                                                                 From="-90" To="900" Duration="0:0:1.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SweepAnim" />
                                    </Trigger.ExitActions>
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slim scrollbar -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="MinWidth" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#333333" Margin="3,2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
